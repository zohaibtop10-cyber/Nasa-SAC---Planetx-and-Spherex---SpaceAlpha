# =====================================================================
# LIVE SKY - ENVIRONMENT CONFIGURATION & API REGISTRY (TEMPLATE)
# =====================================================================

# ---------------------------------------------------------------------
# 1. AI & LLM PROVIDER CREDENTIALS
# ---------------------------------------------------------------------
# Google Gemini API Key (Required for /api/explore-object and Agentic URL-to-3D pipeline)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------
# 2. NASA & ASTRONOMICAL ENDPOINTS (NO AUTHENTICATION REQUIRED)
# All NASA and ESA scientific APIs used in Live Sky are public open science.
# ---------------------------------------------------------------------
# NASA / IPAC SPHEREx Simple Image Access (SIA2) & Cutout API
NASA_SPHEREX_SIA_URL=https://irsa.ipac.caltech.edu/SIA
NASA_SPHEREX_COLLECTIONS=spherex_qr3,spherex_dr1

# NASA JPL Small-Body Database & Identification API (ssd-api)
NASA_JPL_SB_IDENT_URL=https://ssd-api.jpl.nasa.gov/sb_ident.api

# NASA JPL Horizons Ephemeris Vector System
NASA_JPL_HORIZONS_URL=https://ssd.jpl.nasa.gov/api/horizons.api

# NASA Image and Video Library API
NASA_IMAGES_API_URL=https://images-api.nasa.gov/search

# ESA Gaia DR3 Catalog Astronomical TAP Archive
ESA_GAIA_TAP_URL=https://gea.esac.esa.int/tap-server/tap

# Wikimedia / Wikipedia REST Summary API
WIKIPEDIA_REST_API_URL=https://en.wikipedia.org/api/rest_v1/page/summary

# ---------------------------------------------------------------------
# 3. WEB & SERVER CONFIGURATION
# ---------------------------------------------------------------------
PORT=5173
HOST=127.0.0.1
NODE_ENV=development
