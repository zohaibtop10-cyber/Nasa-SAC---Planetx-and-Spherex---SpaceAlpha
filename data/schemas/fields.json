{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FieldsSchema",
  "description": "Schema for SPHEREx curated target sky fields.",
  "type": "object",
  "required": ["fields"],
  "additionalProperties": false,
  "properties": {
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "ra_deg", "dec_deg", "fov_deg", "scans", "labels"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "ra_deg": { "type": "number", "minimum": 0.0, "maximum": 360.0 },
          "dec_deg": { "type": "number", "minimum": -90.0, "maximum": 90.0 },
          "fov_deg": { "type": "number", "exclusiveMinimum": 0.0 },
          "description": { "type": "string" },
          "target_type": { "type": "string" },
          "scans": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["scan_id", "epoch_utc"],
              "additionalProperties": true,
              "properties": {
                "scan_id": { "type": "string" },
                "epoch_utc": { "type": "string", "format": "date-time" },
                "mjd": { "type": "number" },
                "fits_url": { "type": "string" }
              }
            }
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "enum": ["measured", "derived", "assumed"]
            }
          }
        }
      }
    }
  }
}
