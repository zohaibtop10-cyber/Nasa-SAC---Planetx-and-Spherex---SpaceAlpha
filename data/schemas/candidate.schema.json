{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CandidateSchema",
  "description": "Strict JSON Schema for detected SPHEREx mover candidates with triage verdicts and honesty labels.",
  "type": "object",
  "required": ["candidates"],
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "field_id",
          "release_batch",
          "positions",
          "verdict",
          "reason_chain",
          "confidence",
          "match",
          "distance_range",
          "colour_index",
          "labels"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "field_id": {
            "type": "string"
          },
          "release_batch": {
            "type": "string"
          },
          "positions": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["time", "ra", "dec", "err"],
              "additionalProperties": false,
              "properties": {
                "time": { "type": "string" },
                "ra": { "type": "number", "minimum": 0.0, "maximum": 360.0 },
                "dec": { "type": "number", "minimum": -90.0, "maximum": 90.0 },
                "err": { "type": "number", "minimum": 0.0 }
              }
            }
          },
          "verdict": {
            "type": "string",
            "enum": [
              "artifact",
              "known_object",
              "known_asteroid",
              "high_motion_star",
              "fast_moving_star",
              "unknown"
            ]
          },
          "reason_chain": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "required": ["rule", "passed", "detail"],
                  "additionalProperties": true,
                  "properties": {
                    "rule": { "type": "string" },
                    "passed": { "type": "boolean" },
                    "detail": { "type": "string" }
                  }
                }
              ]
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "match": {
            "type": ["object", "null"],
            "additionalProperties": true,
            "properties": {
              "catalog": { "type": "string" },
              "designation": { "type": "string" },
              "body_type": { "type": "string" },
              "separation_arcsec": { "type": "number", "minimum": 0.0 }
            }
          },
          "distance_range": {
            "type": ["object", "null"],
            "required": ["min_au", "max_au", "assumption"],
            "additionalProperties": false,
            "properties": {
              "min_au": { "type": "number", "exclusiveMinimum": 0.0 },
              "max_au": { "type": "number", "exclusiveMinimum": 0.0 },
              "assumption": { "type": "string", "minLength": 1 },
              "scan_ranges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["scan_index", "min_au", "max_au"],
                  "additionalProperties": false,
                  "properties": {
                    "scan_index": { "type": "integer" },
                    "min_au": { "type": "number", "exclusiveMinimum": 0.0 },
                    "max_au": { "type": "number", "exclusiveMinimum": 0.0 }
                  }
                }
              }
            }
          },
          "colour_index": {
            "type": ["number", "null"]
          },
          "simulated": {
            "type": "boolean"
          },
          "velocity_arcsec_day": {
            "type": "number"
          },
          "estimated_size_km": {
            "type": "number"
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "enum": ["measured", "derived", "assumed"]
            }
          }
        }
      }
    }
  }
}
